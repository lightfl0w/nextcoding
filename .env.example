# --- 数据库 ---
DB_URL=file:./db.sqlite

# --- 认证 ---
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
# 浏览器访问认证接口的地址（对浏览器而言的公开域名，用于 origin 校验与重置邮件链接）
BETTER_AUTH_URL=http://localhost:3000
# 打进前端包的地址，仅用于 WebSocket 连接
BACKEND_URL=http://localhost:3000
# 允许发起请求的前端来源（CORS + Better Auth trustedOrigins）。
# 生产环境必须写上前端域名，否则浏览器请求会被拒绝，登录/注册会失败。
# 多个来源用逗号分隔，例如：https://flowcoding.top,https://www.flowcoding.top
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- 邮件（SMTP）---
# 用于发送密码重置邮件。生产环境必须配置，否则邮件只会打印到日志。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 发件人地址，默认使用 SMTP_USER
SMTP_FROM=

# --- 存储 ---
# 可选值：
#   local      本地磁盘（本地开发默认）
#   s3         S3 兼容对象存储（AWS S3 / MinIO / 腾讯 COS / Cloudflare R2）
#   vercel-blob Vercel Blob（仅在 Vercel 部署时使用）
STORAGE_DRIVER=local
# STORAGE_DRIVER=local 时，文件写入该目录（相对 server 运行目录）
STORAGE_LOCAL_DIR=data

# --- S3（STORAGE_DRIVER=s3 时使用）---
S3_REGION=ap-shanghai
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 对外访问域名（CDN 或 endpoint）
S3_PUBLIC_URL=

# --- Vercel Blob（STORAGE_DRIVER=vercel-blob 时使用）---
BLOB_READ_WRITE_TOKEN=
