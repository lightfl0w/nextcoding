# --- 数据库 ---
DB_URL=file:./db.sqlite

# --- 认证 ---
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# --- 存储 ---
# 可选值：
#   local      本地磁盘（本地开发默认）
#   s3         S3 兼容对象存储（AWS S3 / MinIO / 腾讯 COS / Cloudflare R2）
#   vercel-blob Vercel Blob（仅在 Vercel 部署时使用）
STORAGE_DRIVER=local
# STORAGE_DRIVER=local 时，文件写入该目录（相对 server 运行目录）
STORAGE_LOCAL_DIR=data

# --- S3（STORAGE_DRIVER=s3 时使用）---
S3_REGION=ap-shanghai
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 对外访问域名（CDN 或 endpoint）
S3_PUBLIC_URL=

# --- Vercel Blob（STORAGE_DRIVER=vercel-blob 时使用）---
BLOB_READ_WRITE_TOKEN=
